# OpenClaw — copy to .env and edit as needed
# All paths are absolute or relative to repo root.

# --- LLM (llama-server) ---
OPENCLAW_LLM_MODE=stub                    # stub | live
OPENCLAW_LLM_BASE_URL=http://127.0.0.1:8080/v1
OPENCLAW_LLM_MODEL=gemma-4-26B-A4B-it
OPENCLAW_LLM_API_KEY=sk-local

# --- Embeddings (second llama-server) ---
OPENCLAW_EMBED_MODE=stub                  # stub | live
OPENCLAW_EMBED_BASE_URL=http://127.0.0.1:8081/v1
OPENCLAW_EMBED_MODEL=bge-m3
OPENCLAW_EMBED_API_KEY=sk-local
OPENCLAW_EMBED_DIM=384                    # stub mode dim; live uses model-reported dim

# --- llama.cpp paths (used by scripts/) ---
LLAMA_BIN=/home/aifactory/llama.cpp/llama-b8770/llama-server
LLAMA_CHAT_MODEL=/home/aifactory/models/gemma-4-26B-A4B-it-UD-Q4_K_M.gguf
LLAMA_EMBED_MODEL=/home/aifactory/models/bge-m3-q4_k_m.gguf

# --- Storage ---
OPENCLAW_VAULT_DIR=./vault
OPENCLAW_TASKS_REPO=./tasks
OPENCLAW_SQLITE_PATH=./data/openclaw.db
OPENCLAW_QDRANT_PATH=./data/qdrant            # local persistent embedded mode
# OPENCLAW_QDRANT_URL=http://127.0.0.1:6333  # uncomment to use a running Qdrant server

# --- Misc ---
OPENCLAW_LOG_LEVEL=INFO
