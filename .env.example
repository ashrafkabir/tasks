# Consilo — copy to .env and edit as needed
# All paths are absolute or relative to repo root.

# --- LLM (llama-server) ---
CONSILO_LLM_MODE=stub                    # stub | live
CONSILO_LLM_BASE_URL=http://127.0.0.1:8080/v1
CONSILO_LLM_MODEL=gemma-4-26B-A4B-it
CONSILO_LLM_API_KEY=sk-local

# --- Embeddings (second llama-server) ---
CONSILO_EMBED_MODE=stub                  # stub | live
CONSILO_EMBED_BASE_URL=http://127.0.0.1:8081/v1
CONSILO_EMBED_MODEL=bge-m3
CONSILO_EMBED_API_KEY=sk-local
CONSILO_EMBED_DIM=384                    # stub mode dim; live uses model-reported dim

# --- llama.cpp paths (used by scripts/) ---
LLAMA_BIN=/home/aifactory/llama.cpp/llama-b8770/llama-server
LLAMA_CHAT_MODEL=/home/aifactory/models/gemma-4-26B-A4B-it-UD-Q4_K_M.gguf
LLAMA_EMBED_MODEL=/home/aifactory/models/bge-m3-q4_k_m.gguf

# --- Storage ---
CONSILO_VAULT_DIR=./vault
CONSILO_TASKS_REPO=./tasks
CONSILO_SQLITE_PATH=./data/consilo.db
CONSILO_QDRANT_PATH=./data/qdrant            # local persistent embedded mode
# CONSILO_QDRANT_URL=http://127.0.0.1:6333  # uncomment to use a running Qdrant server

# --- Misc ---
CONSILO_LOG_LEVEL=INFO

# --- Bridges (Telegram + WhatsApp via wuzapi) ---
CONSILO_NOTIFY_MODE=stub                         # stub | live
CONSILO_DEFAULT_CLIENT=acme
CONSILO_DEFAULT_PROJECT=digital-platform

# Telegram
TELEGRAM_BOT_TOKEN=                               # from @BotFather
TELEGRAM_OPERATOR_CHAT_ID=                        # your personal chat id (numeric)

# WhatsApp via wuzapi (OSS, https://github.com/asternic/wuzapi)
WUZAPI_BASE_URL=http://127.0.0.1:8089
WUZAPI_TOKEN=                                     # wuzapi user token
WUZAPI_OPERATOR_JID=                              # e.g. 12025550100@s.whatsapp.net
WUZAPI_WEBHOOK_SECRET=                            # optional shared secret for webhook auth

# Bridge HTTP server (receives wuzapi webhooks)
CONSILO_BRIDGE_HOST=127.0.0.1
CONSILO_BRIDGE_PORT=8090

# --- Dashboard (HTMX + Tailwind) ---
CONSILO_DASHBOARD_HOST=127.0.0.1
CONSILO_DASHBOARD_PORT=8091

# --- SearXNG monitor ---
SEARXNG_URL=http://127.0.0.1:8888
